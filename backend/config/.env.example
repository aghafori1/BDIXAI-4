# Local defaults. Keep real secrets in environment variables, never commit them.
DEBUG=true
SECRET_KEY=replace-this-for-production
ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_NOTIFICATION_EMAIL=your-email@example.com
DEFAULT_FROM_EMAIL=notifications@your-verified-domain.com
RESEND_API_KEY=re_example_replace_me
# Optional one-time initial admin bootstrap; delete the password variable after the first successful deploy.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=your-email@example.com
DJANGO_SUPERUSER_PASSWORD=use-a-long-unique-password
